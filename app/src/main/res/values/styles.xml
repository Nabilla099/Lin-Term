<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#000000</item>
    </style>

    <!-- Neo-brutalist drawer buttons: kotak tajam, border tebal, mono bold -->
    <style name="LinBrutalButton" parent="@style/Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">@color/lin_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/LinBrutalButton">
        <item name="backgroundTint">@color/lin_pink</item>
        <item name="android:textColor">@color/lin_ink</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/LinBrutalButton">
        <item name="backgroundTint">@color/lin_yellow</item>
        <item name="android:textColor">@color/lin_ink</item>
    </style>

</resources>
